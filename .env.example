# Lokkatha Environment Configuration
#
# NOTE: Settings uses pydantic-settings with env_nested_delimiter="__".
# Nested fields are set as SECTION__FIELD, e.g. CRAWLER__MAX_PAGES maps to
# crawler.max_pages. The previous CRAWLER_MAX_PAGES / POSTGRES_* names were
# never read by the application.

LOKKATHA_ENV=development
LOKKATHA_LOG_LEVEL=INFO

# Crawler Configuration Overrides (maps to crawler.* in config.yaml)
CRAWLER__MAX_PAGES=1000
CRAWLER__MAX_DEPTH=4
CRAWLER__CONCURRENCY=5
CRAWLER__DELAY_SECONDS=1.0
CRAWLER__REQUEST_TIMEOUT=20.0

# Database Configuration (maps to database.* ; PostgreSQL + pgvector)
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=lokkatha
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres

# Optional AI / LLM Configuration (maps to ai.*)
AI__ENABLED=false
AI__PROVIDER=none
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
