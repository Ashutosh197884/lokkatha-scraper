# Lokkatha Environment Configuration
LOKKATHA_ENV=development
LOKKATHA_LOG_LEVEL=INFO

# Crawler Configuration Overrides
CRAWLER_MAX_PAGES=1000
CRAWLER_MAX_DEPTH=4
CRAWLER_CONCURRENCY=5
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_REQUEST_TIMEOUT=20.0

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lokkatha
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional AI / LLM Configuration
AI_ENABLED=false
AI_PROVIDER=none
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
